{
  "name": "vscode-terminal-preview",
  "displayName": "vscode-terminal-preview",
  "description": "Make terminal file links respect workbench.editor.enablePreview for configurable file types.",
  "version": "0.1.0",
  "publisher": "crd233",
  "license": "MIT",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "terminal",
    "preview",
    "links",
    "files"
  ],
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "contributes": {
    "configuration": {
      "title": "vscode-terminal-preview",
      "properties": {
        "terminalPreview.extensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^\\.?[a-zA-Z0-9]+$"
          },
          "uniqueItems": true,
          "default": [
            "png",
            "jpg",
            "jpeg",
            "gif",
            "webp",
            "bmp",
            "ico",
            "svg",
            "avif",
            "mp4",
            "webm",
            "mov",
            "m4v",
            "ogv",
            "mp3",
            "wav",
            "ogg",
            "oga",
            "flac",
            "aac",
            "m4a"
          ],
          "markdownDescription": "使用编辑器预览设置打开这些扩展名的终端文件链接（不区分大小写，可带前导点）。默认包含常见图片、音视频类型，可配置为其他文件类型；未列出的类型保持原生行为。",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.7.0",
    "vscode-uri": "^3.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/crd2333/vscode-terminal-preview.git"
  }
}
